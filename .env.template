# Šablona souboru .env pro nastavení prostředí aplikace
# Zkopíruj tento soubor do .env a uprav hodnoty podle potřeby (cp .env.template .env)

# DATABASE CONFIGURATION
DB_NAME=hmiyc
DB_USER=postgres
DB_PASSWORD=postgres@123

# ENVIRONMENT SELECTION
# Dostupné hodnoty: local, docker, dev, prod
ENVIRONMENT=docker

# SHARED API KEYS (Google GenAI)
GOOGLE_GENAI_API_KEY=your-google-genai-api-key-here

# SHARED INTERNAL API KEY (backend + skripty)
INTERNAL_API_KEY=your-internal-api-key

# ================================
# API CONFIGURATION BY ENVIRONMENT
# ================================

# LOCAL (localhost, bez Dockeru)
LOCAL_API_BASE_URL=http://localhost:8080
LOCAL_INTERNAL_API_KEY=your-local-internal-api-key

# DOCKER (Docker compose)
DOCKER_API_BASE_URL=http://localhost:8080
DOCKER_INTERNAL_API_KEY=your-docker-internal-api-key

# DEV (Hosted development)
DEV_API_BASE_URL=https://dev-api.example.com
DEV_INTERNAL_API_KEY=your-dev-internal-api-key

# PROD (Production)
PROD_API_BASE_URL=https://api.example.com
PROD_INTERNAL_API_KEY=your-prod-internal-api-key
