# Jazyk a region aplikace (pro lokalizaci - např. překlad textu do správného jazyka)
VITE_API_LOCALE=cs-CZ
# Čas (v sekundách) na zodpovězení jedné otázky
VITE_TIME_PER_QUESTION=60
# Maximální počet otázek v jedné hře (0 = bez limitu)
VITE_GAME_QUESTIONS_LIMIT=20
VITE_API_BASE_URL=http://localhost:8080
VITE_API_SWAGGER_JSON_PATH=/v3/api-docs
